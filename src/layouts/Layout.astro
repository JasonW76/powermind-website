---
import "../styles/global.css";
const { title, description, active, noindex } = Astro.props;
const buildDate = new Date().toLocaleDateString("en-AU", { month: "long", year: "numeric" });
// Strip the .html the file build format adds to the path, so the canonical
// matches the clean, extension-less URL Cloudflare serves and the sitemap lists
// (e.g. /app, not /app.html).
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ""), Astro.site).href;
const ogImage = new URL("/og-image.png", Astro.site).href;
const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Powermind",
  url: "https://www.powermind.com.au",
  logo: new URL("/apple-touch-icon.png", Astro.site).href,
  description: "Software that catches your rooftop solar before it's exported — automating your home's biggest loads to run on your own sunshine.",
  parentOrganization: { "@type": "Organization", name: "Futerra", url: "https://futerra.ai" },
  sameAs: ["https://futerra.ai"],
};
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Powermind",
  url: "https://www.powermind.com.au",
};
---
<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}
<link rel="canonical" href={canonical} />
<meta name="theme-color" content="#0a0c0f" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Powermind" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_AU" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<script type="application/ld+json" set:html={JSON.stringify(org)} />
<script type="application/ld+json" set:html={JSON.stringify(website)} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <nav>
    <div class="nav-in">
      <a class="brand" href="/"><img src="/pm-logo.png" alt="Powermind" width="43" height="43" /><span>Powermind</span></a>
      <div class="nav-links">
        <a href="/" class={active === "home" ? "active" : ""}>Home</a>
        <a href="/calculator" class={active === "calc" ? "active" : ""}>Calculator</a>
        <a href="/app" class={active === "app" ? "active" : ""}>The app</a>
        <a class="btn btn-amber" href="/app#beta">Join the beta →</a>
      </div>
    </div>
  </nav>
  <slot />
  <footer>
    <div class="wrap foot-in">
      <a class="brand" href="/"><img src="/pm-logo.png" alt="Powermind" width="24" height="24" /><span>Powermind</span></a>
      <div class="foot-nav">
        <a href="/calculator">Calculator</a>
        <a href="/app">The app</a>
        <a href="/app#beta">Beta</a>
      </div>
      <div class="foot-right">
        <a href="mailto:jason@futerra.ai">jason@futerra.ai</a><br />
        Powermind · a Futerra company · Updated {buildDate}
      </div>
    </div>
  </footer>
</body>
</html>
