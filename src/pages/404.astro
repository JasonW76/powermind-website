---
import Layout from "../layouts/Layout.astro";
---
<Layout
  title="Page not found — Powermind"
  description="That page doesn't exist. Head back to the Powermind home page, size your solar with the free calculator, or read about the app."
  active=""
  noindex={true}
>
  <section class="blk" style="text-align:center">
    <div class="wrap" style="max-width:640px">
      <p style="font-size:15px; font-weight:650; letter-spacing:.14em; text-transform:uppercase; color:var(--amber); margin:0 0 14px">Error 404</p>
      <h1 style="font-size:clamp(30px,6vw,44px); line-height:1.15; margin:0 0 16px">This page isn&#8217;t here.</h1>
      <p style="color:var(--muted); font-size:17px; margin:0 auto 30px; max-width:460px">
        The link may be old or mistyped. Here&#8217;s the way back to the useful stuff.
      </p>
      <div class="ctas" style="display:inline-flex; gap:12px; flex-wrap:wrap; justify-content:center">
        <a class="btn btn-amber" href="/">Back to home</a>
        <a class="btn btn-ghost" href="/calculator">Solar calculator</a>
        <a class="btn btn-ghost" href="/app">The app</a>
      </div>
    </div>
  </section>
</Layout>
